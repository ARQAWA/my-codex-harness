{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'hooks','context-router.cjs')).sessionStart()\"",
            "timeout": 7
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'hooks','context-router.cjs')).subagentStart()\"",
            "timeout": 7
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(spawn_agent|send_message|followup_task|send_message_to_thread)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'hooks','context-router.cjs')).preToolUse()\"",
            "timeout": 7
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(spawn_agent|send_message|followup_task|send_message_to_thread)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'hooks','context-router.cjs')).postToolUse()\"",
            "timeout": 7
          }
        ]
      }
    ]
  }
}

{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(shell|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'hooks','fssearch-guard.cjs')).preToolUse()\"",
            "timeout": 7
          }
        ]
      }
    ]
  }
}
